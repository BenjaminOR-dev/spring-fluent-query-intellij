<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.benjaminor.fluentquery</id>
    <name>Spring Fluent Query</name>
    <vendor url="https://github.com/BenjaminOR-dev">Benjamín Olvera R.</vendor>

    <resource-bundle>messages.FluentQueryBundle</resource-bundle>

    <description><![CDATA[
    IDE support for <a href="https://github.com/BenjaminOR-dev/spring-fluent-query">spring-fluent-query</a>:
    autocomplete, references, and inspections for entity fields, associations, and nested paths in fluent query strings
    (<code>where</code>, <code>select</code>, <code>fetch</code>, <code>whereHas</code>, …).
    Reads JPA entities from the open project.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor
                language="JAVA"
                implementation="dev.benjaminor.fluentquery.intellij.reference.FluentQueryPathReferenceContributor"/>

        <completion.contributor
                language="JAVA"
                implementationClass="dev.benjaminor.fluentquery.intellij.completion.FluentQueryPathCompletionContributor"/>

        <localInspection
                language="JAVA"
                shortName="FluentQueryUnresolvedPath"
                key="inspection.unresolved.path.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="dev.benjaminor.fluentquery.intellij.inspection.FluentQueryUnresolvedPathInspection"/>

        <localInspection
                language="JAVA"
                shortName="FluentQueryFetchWithProjection"
                key="inspection.fetch.with.projection.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="dev.benjaminor.fluentquery.intellij.inspection.FluentQueryFetchWithProjectionInspection"/>

        <localInspection
                language="JAVA"
                shortName="FluentQueryFetchCollectionWithPagination"
                key="inspection.fetch.collection.pagination.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="dev.benjaminor.fluentquery.intellij.inspection.FluentQueryFetchCollectionWithPaginationInspection"/>

        <localInspection
                language="JAVA"
                shortName="FluentQueryDeprecatedAs"
                key="inspection.deprecated.as.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="dev.benjaminor.fluentquery.intellij.inspection.FluentQueryDeprecatedAsInspection"/>

        <localInspection
                language="JAVA"
                shortName="FluentQuerySelectWithoutProjection"
                key="inspection.select.without.projection.display.name"
                groupKey="inspection.group.name"
                enabledByDefault="true"
                level="WEAK WARNING"
                implementationClass="dev.benjaminor.fluentquery.intellij.inspection.FluentQuerySelectWithoutProjectionInspection"/>
    </extensions>
</idea-plugin>
